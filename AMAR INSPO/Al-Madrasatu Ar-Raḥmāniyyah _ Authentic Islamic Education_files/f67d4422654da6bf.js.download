"},{question:"What time are the live Arabic classes held?",answer:"Live Arabic classes are held at 7:30 PM UK time on Mondays, Tuesdays, and Wednesdays starting March 23rd.",category:"Live Classes"},{question:"Are live classes recorded if I can't attend?",answer:"Yes! All live classes are recorded and available on-demand within 24 hours. You can learn at your own pace.",category:"Live Classes"},{question:"Can I learn at my own pace?",answer:"Absolutely. While live classes follow a schedule, all content is recorded and available on-demand. Study whenever suits you.",category:"Live Classes"},{question:"What if I miss a live class?",answer:"No problem! All sessions are recorded and uploaded within 24 hours. You won't miss any content.",category:"Live Classes"},{question:"Videos won't play - what should I do?",answer:"Refresh the page, clear your browser cache, or try Chrome or Firefox. Disable ad blockers if issues persist.",category:"Technical Support"}];function r(e){return t.filter(t=>t.category===e)}function n(){return[...new Set(t.map(e=>e.category))]}e.s(["getAllFAQCategories",()=>n,"getFAQsByCategory",()=>r],763103);var i=e.i(843476),s=e.i(271645),a=e.i(30030),l=e.i(75830),o=e.i(820783),c=e.i(981140),u=e.i(369340),d=e.i(248425),f=e.i(687607),p=e.i(610772),h=e.i(586318),m="Accordion",y=["Home","End","ArrowDown","ArrowUp","ArrowLeft","ArrowRight"],[x,g,b]=(0,l.createCollection)(m),[v,w]=(0,a.createContextScope)(m,[b,f.createCollapsibleScope]),C=(0,f.createCollapsibleScope)(),N=s.default.forwardRef((e,t)=>{let{type:r,...n}=e;return(0,i.jsx)(x.Provider,{scope:e.__scopeAccordion,children:"multiple"===r?(0,i.jsx)(E,{...n,ref:t}):(0,i.jsx)(S,{...n,ref:t})})});N.displayName=m;var[j,A]=v(m),[k,R]=v(m,{collapsible:!1}),S=s.default.forwardRef((e,t)=>{let{value:r,defaultValue:n,onValueChange:a=()=>{},collapsible:l=!1,...o}=e,[c,d]=(0,u.useControllableState)({prop:r,defaultProp:n??"",onChange:a,caller:m});return(0,i.jsx)(j,{scope:e.__scopeAccordion,value:s.default.useMemo(()