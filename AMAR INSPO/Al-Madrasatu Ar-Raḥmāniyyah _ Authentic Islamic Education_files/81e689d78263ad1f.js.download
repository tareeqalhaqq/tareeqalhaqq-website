nction(e){return e._sortY=e.trigger?t+e.trigger.getBoundingClientRect().top:e.start+K.innerHeight}),tk.sort(e||function(e,t){return -1e6*(e.vars.refreshPriority||0)+(e.vars.containerAnimation?1e6:e._sortY)-((t.vars.containerAnimation?1e6:t._sortY)+-1e6*(t.vars.refreshPriority||0))})},t8.observe=function(e){return new V(e)},t8.normalizeScroll=function(e){if(void 0===e)return eg;if(!0===e&&eg)return eg.enable();if(!1===e){eg&&eg.kill(),eg=e;return}var t=e instanceof V?e:ri(e);return eg&&eg.target===t.target&&eg.kill(),eX(t.target)&&(eg=t),t},t8.core={_getVelocityProp:H,_inputObserver:rs,_scrollers:A,_proxies:C,bridge:{ss:function(){eL||tR("scrollStart"),eL=eO()},ref:function(){return el}}},eW()&&G.registerPlugin(t8);var rl=e.i(32095),ro=e.i(107233);n.default.registerPlugin(t8);let rc=[{date:"Jan 1, 2026",highlight:!0,items:[{title:"Prerequisites to Seeking Knowledge & AMAR Cares",description:"The prerequisites to seeking knowledge segment entails a new video being released daily for 15 consecutive days, outlining the prerequisites of seeking knowledge and highlighting key principles every student should understand before beginning their journey.\n\nAMAR Cares will be released alongside this programme. AMAR Cares is a dedicated humanitarian initiative created to receive and distribute donations to those most in need. Through this program, contributions are directed toward meaningful causes such as supporting students of knowledge, caring for orphaned children, building wells and schools, assisting the disabled, and providing relief to families facing hardship. AMAR Cares also helps students enrolled in our programs and those studying in Islamic universities who require financial support. Every donation entrusted to AMAR Cares is used to uplift, empower, and provide essential aid to individuals and communities in need."}]},{date:"Jan 15, 2026",items:[{title:"Foundational Arabic Programme",description:"A foundational level Arabic course with 60 comprehensive lessons launches, covering the fundamentals and ensuring all the essential concepts are thoroughly explained. This level will cover the following: The Arabic alphabet, learning how to read and write each letter, short vowels and diacritical marks, particularly, tanween, sukoon, and shaddah, connecting and detaching and lastly Laam Al-Qamariyyah and Laam Ash-Shamsiyyah. This level is perfect for complete beginners as well as those looking to sharpen their skills before they move on to the next stage."},{title:"Introduction to Precision in Knowledge",description:"All introductory lessons for the Precision in Knowledge programme across the seven different faculties become available. This programme offers a thorough introduction into all pathways, namely: Aqeedah And The Foundations of the Religion, Fiqh and Its Principles, Tafseer And The Sciences Of The Quran, Hadeeth And Its Sciences, Seerah And Its History and lastly, Sciences Of Language And Logic."}]},{date:"Mar 23, 2026",items:[{title:"The AMAR Arabic Program",description:"The AMAR Arabic Program taught by Ustadh AbdulRahman Hassan is a three-stage journey that takes students from absolute beginner to advanced proficiency and even into teaching Arabic. Stage One is a 15-month intensive course starting from the alphabet and building up to strong fluency. Stage Two is designed for students of Islamic knowledge, giving them the language skills needed to access the Qur'an, Sunnah, classical texts, and Shari'ah terminology with clarity. Stage Three, known as CALTA (Certificate in Arabic Language Teaching for Advanced Students), trains advanced learners to become qualified Arabic teachers."},{title:"The AMAR Precision in Knowledge Program",description:"The AMAR Precision in Knowledge Program is a structured five-year journey designed for students who wish to study the classical Islamic sciences with depth and clarity. The program takes learners from introductory and foundational levels all the way to advanced texts across six core faculties: Aqeedah and its foundations, Fiqh and its foundations, Qur'an and its sciences, Seerah and history, Arabic language and logic, and Tarbiyah and Tazkiyah. Each faculty is carefully organised into progressive stages—beginner, intermediate, and advanced—delivered through a comprehensive, pre-recorded curriculum. This program provides a complete pathway for anyone seeking precision, structure, and excellence in their journey of Islamic knowledge.\n\nBoth of these programmes are entirely unique, and the first of their kind as videos across all levels will be released simultaneously."}]},{date:"Late 2026",items:[{title:"AMAR Mentorship",description:"AMAR Mentorship is a structured two-year program for both juniors and adults, offering live classes, interactive sessions, and personalized consultations with Ustadh Abdulrahman Hassan and other qualified instructors from the AMAR team. The program guides students through the works of classical scholars, helping them navigate daily challenges while cultivating strong Islamic principles. With a special emphasis on purification of the heart, AMAR Mentorship aims to develop grounded, confident, and spiritually refined individuals.\n\nLaunching in September 2026."},{title:"AMAR Memorization",description:"AMAR Memorization is a comprehensive program designed to guide students in memorizing the Qur'an within three years for those who work diligently, or five years for a more gradual pace. Alongside the Qur'an, students will also memorize selected classical texts in poetic form from various Islamic sciences, carefully chosen by Ustadh Abdulrahman Hassan. The program aims to cultivate a deep internalization of knowledge, enabling students to carry the Qur'an and key scholarly works in their memory without reliance on books. AMAR Memorization seeks to revive the rich heritage of memorization that has been a cornerstone of Islamic tradition for centuries."},{title:"AMAR Profiles",description:"AMAR Profiles is a documentary program dedicated to preserving and presenting important events, topics, and figures from Islamic history. The program will produce high-quality documentaries covering historical sites, significant events, and key moments in Muslim heritage - such as the Muslims of Andalus - using engaging motion graphics and professional editing. Initially released twice a year, the program aims to expand to quarterly releases, providing viewers with accessible, well-researched, and visually compelling content that educates and inspires."},{title:"AMAR Dawrah Ilmiyyah",description:"AMAR Dawrah Ilmiyyah is an exclusive scholarly program for students registered in any of AMAR's programs. Held annually across five continents - North America, Europe, Asia, Australia, and Africa, the program travels to different countries within each continent, offering participants a unique opportunity for live, face-to-face learning. The curriculum focuses on the classical texts taught in the Precision in Knowledge Program, allowing attendees to study, ask questions, and engage directly with instructors. This Dawrah Ilmiyyah is reserved solely for registered AMAR students, providing a privileged, immersive, and personalized educational experience."},{title:"AMAR Ijazah Program",description:"AMAR Ijazah Program is designed for students who have completed the Dawrah Ilmiyyah. Upon finishing the program in a given continent, students are given the opportunity to earn an Ijazah, a formal authorization linking them through a chain of transmission to the original author of the text being studied. Ijazahs will be offered on multiple classical books at various points during AMAR's global travels. This program is open to both brothers and sisters but remains exclusive to registered AMAR students, providing them with an authentic and prestigious pathway to preserve and transmit Islamic knowledge."}]}],rd=[{icon:(0,t.jsx)("span",{className:"text-2xl font-bold",style:{fontFamily:"serif"},children:"ع"}),title:"AMAR Arabic",subtitle:"Live classes with Ustadh Abdulrahman (3x a week)",description:"From reading and writing to classical text comprehension.",features:["Foundational: 60 lessons","Zero to Hero: 15-month pathway","CALTA: Teaching certificate"],badge:"Starting Jan 15"},{icon:(0,t.jsx)(rl.GraduationCap,{className:"w-6 h-6"}),title:"Precision in Knowledge",subtitle:"7 Faculties of Islamic Sciences",description:"Pre-recorded comprehensive study programme.",features:["Aqeedah & Fiqh","Tafsir & Hadith","Seerah, Arabic & Logic"],badge:"5-year programme"}];function ru({title:e,description:r,isExpanded:s,onToggle:n}){return(0,t.jsxs)("div",{className:`relative w-full rounded-xl overflow-hidden group/card transition-all duration-300 ${s?"ring-1 ring-white/10":""}`,children:[(0,t.jsx)("div",{className:`absolute inset-0 border bg-white/[0.02] rounded-xl transition-all duration-300 ${s?"border-white/15 opacity-100":"border-white/10 opacity-75 group-hover/card:opacity-100 group-hover/card:border-white/15"}`,style:{backdropFilter:"blur(40px)",WebkitBackdropFilter:"blur(40px)"}}),(0,t.jsxs)("div",{className:"relative",children:[(0,t.jsxs)("button",{onClick:n,className:"w-full p-5 sm:p-6 text-left flex items-start justify-between gap-4 cursor-pointer group/header","aria-expanded":s,children:[(0,t.jsx)("h3",{className:"text-lg sm:text-xl font-bold text-white group-hover/header:text-white/90 transition-colors",children:e}),(0,t.jsx)("div",{className:`flex-shrink-0 w-8 h-8 rounded-full bg-white/5 border border-white/10 flex items-center justify-center transition-all duration-300 group-hover/header:bg-white/10 group-hover/header:border-white/20 ${s?"rotate-45 bg-white/10 border-white/20":""}`,children:(0,t.jsx)(ro.Plus,{className:"w-4 h-4 text-white/70"})})]}),(0,t.jsx)("div",{className:"grid transition-all duration-300 ease-out",style:{gridTemplateRows:s?"1fr":"0fr"},children:(0,t.jsx)("div",{className:"overflow-hidden",children:(0,t.jsxs)("div",{className:"px-5 sm:px-6 pb-5 sm:pb-6 pt-0